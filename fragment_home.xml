<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="J A R V I S"
            android:textColor="@color/neon"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- AI avatar face inside the glowing ring -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="16dp">

            <com.doodlejoy.jarvis.ui.GlowingRingView
                android:id="@+id/ringView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/avatarFace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🤖"
                android:textSize="84sp" />
        </FrameLayout>

        <!-- Speech bubble: what JARVIS says -->
        <TextView
            android:id="@+id/speechBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/bubble_ai"
            android:padding="14dp"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tap_to_talk"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- Big mic button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/micButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/tap_to_talk"
            android:src="@android:drawable/ic_btn_speak_now"
            app:backgroundTint="@color/neon"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- Phone info card -->
        <TextView
            android:id="@+id/phoneInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/bg_panel"
            android:padding="12dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/conversationToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="কথোপকথন মোড চালু করুন" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wakeWordToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ওয়েক ওয়ার্ড (&quot;জার্ভিস&quot;) চালু করুন" />

    </LinearLayout>
</ScrollView>
