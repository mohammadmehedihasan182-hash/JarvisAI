<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="সেটিংস ও মেমোরি"
            android:textColor="@color/neon"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="আপনার নাম (জার্ভিস মনে রাখবে)"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ভাষা / Language"
            android:textColor="@color/text_main" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/langBn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাংলা"
                android:textColor="@color/text_main" />

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="English"
                android:textColor="@color/text_main" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="কণ্ঠের গতি"
            android:textColor="@color/text_main" />

        <SeekBar
            android:id="@+id/voiceRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="সেভ করুন" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="নিরাপত্তা: কল, SMS-এর মতো সংবেদনশীল কাজে জার্ভিস সবসময় আগে জিজ্ঞেস করবে। API key কখনো ফোনে থাকে না — সার্ভারে থাকে।\n\nনোট: ওয়েক ওয়ার্ড চালু থাকলে স্ক্রিনে স্থায়ী নোটিফিকেশন থাকবে এবং ব্যাটারি একটু বেশি খরচ হবে। ফোনের Settings → Apps → JARVIS → Battery-তে গিয়ে &quot;Unrestricted&quot; করে দিন।"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
