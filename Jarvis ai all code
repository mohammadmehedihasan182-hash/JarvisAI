        silenceCount = 0
        if (_binding != null) {
            binding.conversationToggle.text = "কথোপকথন মোড বন্ধ করুন"
            say(if (prefs.language == "en") "Conversation mode on. I am listening." else "কথোপকথন মোড চালু। বলুন, শুনছি।")
