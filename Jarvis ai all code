        addMessage(ChatMessage(if (prefs.language == "en") "Hello! I am JARVIS. Type or use the mic." else "আসসালামু আলাইকুম! আমি জার্ভিস। লিখুন অথবা মাইকে বলুন।", fromUser = false), speak = false)

